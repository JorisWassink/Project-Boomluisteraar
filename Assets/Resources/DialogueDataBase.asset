  characterDataBase: {fileID: 11400000, guid: 083e21b57cd4706f78b360aab22be12b, type: 2}
  defaultSprite: {fileID: 2800000, guid: 76a3799ad294ad250a53cacaaa295782, type: 3}
  eventDialogues:
  - eventType: 0
    character: 91261114
    dialogues:
      chunkEntries:
      - isEvent: 0
        dialogueText: ....Hi
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "So you\u2019re the new kid? Great\u2026guess we\u2019re stuck
          with you"
        command: 0
        emotion: 2
      - isEvent: 0
        dialogueText: "Well, I guess I have to show you around\u2026not like you
          can just figure it out on your own\u2026"
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "Click on that button there to start. Or\u2026don\u2019t. I\u2019d
          prefer it if you don\u2019t"
        command: 0
        emotion: 2
      - isEvent: 1
        dialogueText: "Click on that button there to start. Or\u2026don\u2019t. I\u2019d
          prefer it if you don\u2019t"
        command: 0
        emotion: 2
      characterID: 91261114
    characterEntry:
      treeName: Purple Beech
      characterName: Copper
      sprites:
        defaultSprite: {fileID: 2800000, guid: 74244c27d2e5aa26f985d11e8013cbcd, type: 3}
        happySprite: {fileID: 2800000, guid: 7f766bc6e5c9c94f996f684bdd1029da, type: 3}
        grumpySprite: {fileID: 2800000, guid: 8ba7d2f4b7c91541abeffaf38fc2a684, type: 3}
      expRequirement: 0
      characterId: 91261114
  - eventType: 1
    character: 91261114
    dialogues:
      chunkEntries:
      - isEvent: 0
        dialogueText: "Couldn\u2019t wait to get started, huh? What a shame\u2026"
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "Listen, I\u2019m not the best with this..."
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: Introductory stuff...
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "Cause it sucks, and I hate it\u2026"
        command: 0
        emotion: 2
      - isEvent: 0
        dialogueText: "But lucky me. Polly wrote me a script here\u2026"
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "I guess I have to read it now\u2026"
        command: 0
        emotion: 2
      - isEvent: 0
        dialogueText: '''Welcome to Pal Park, the Park where you make Pals.'''
        command: 0
        emotion: 1
      - isEvent: 0
        dialogueText: "'My name\u2019s Copper, and I\u2019ll be your guide.'"
        command: 0
        emotion: 1
      - isEvent: 0
        dialogueText: "'Here, you\u2019ll learn all about the various wonderful trees
          that call this place home..."
        command: 0
        emotion: 1
      - isEvent: 0
        dialogueText: And hopefully make some new friends along the way.'
        command: 0
        emotion: 1
      - isEvent: 0
        dialogueText: "\u2018Strike a welcoming pose\u2019."
        command: 0
        emotion: 1
      - isEvent: 0
        dialogueText: Wait...
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: Thats not part of the script
        command: 0
        emotion: 2
      - isEvent: 0
        dialogueText: "I\u2019m not reading the rest. You get the gist."
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "You\u2019re in a park. You talk to trees. Etcetera"
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "You don\u2019t need more advice. Just\u2026click around and
          see what happens."
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "I\u2019m not your babysitter"
        command: 0
        emotion: 2
      - isEvent: 0
        dialogueText: "And if you wanna talk to me\u2026"
        command: 0
        emotion: 0
      - isEvent: 0
        dialogueText: "at least try to not be annoying\u2026"
        command: 0
        emotion: 2
      - isEvent: 0
        dialogueText: "Anyway, you\u2019re free to go now\u2026bye."
        command: 0
        emotion: 0
      characterID: 91261114
    characterEntry:
      treeName: Purple Beech
      characterName: Copper
      sprites:
