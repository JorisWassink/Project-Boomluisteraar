          emotion: 0
        - isEvent: 0
          dialogueText: It was on the news the other day
          command: 0
          emotion: 1
        characterID: 
    - dialogueChunkList:
        chunkEntries:
        - isEvent: 0
          dialogueText: I need to make sure I dont speak my mind too much
          command: 0
          emotion: 0
        - isEvent: 0
          dialogueText: Otherwise they will do the same to me as they did to annie
          command: 0
          emotion: 2
        characterID: 
    - dialogueChunkList:
        chunkEntries:
        - isEvent: 0
          dialogueText: Give me your kneecaps
          command: 0
